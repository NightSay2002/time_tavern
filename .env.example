# 複製此檔案為 .env，然後只填寫你需要啟用的設定。

# 伺服器
PORT=3234
# `npm start` 啟動時檢查一次 GitHub；設為 0、false 或 off 可關閉。
TIME_TAVERN_AUTO_UPDATE=1

# Discord Bot
# 不填 DISCORD_BOT_TOKEN 時，只會啟動本地網頁管理端，不會登入 Discord。
DISCORD_BOT_TOKEN=
# 選填。若無法從 Bot Token 解出 Client ID，會用這個產生帶 bot / applications.commands scope 的 Discord 邀請連結。
DISCORD_CLIENT_ID=
# 選填。設定後只接受這個 Discord User ID 的指令、訊息、編輯與反應。
DISCORD_ALLOWED_USER_ID=
# 選填備援。Bot 上線後會自動取得 Public Key；若 Webhook 可能早於 Bot 連線，可填 Developer Portal 的 Public Key。
DISCORD_PUBLIC_KEY=
# Discord .txt 附件大小上限，單位是 bytes。預設：1048576（1 MB）。
DISCORD_TEXT_ATTACHMENT_MAX_BYTES=1048576
# 一般頻道對話失敗時，錯誤回覆在原頻道並於指定秒數後刪除。範圍 1 至 300，預設 15。
DISCORD_ERROR_AUTO_DELETE_SECONDS=15
# Discord 登入遇到暫時性網路錯誤時會自動重試。預設 15 秒起跳，最多退避到 5 分鐘。
DISCORD_LOGIN_RETRY_INITIAL_MS=15000
DISCORD_LOGIN_RETRY_MAX_MS=300000
# 0 代表不限次數。若填 5，代表最多嘗試 5 次。
DISCORD_LOGIN_RETRY_MAX_ATTEMPTS=0

# QQ 官方 Bot（只處理私聊 C2C）
# AppID 與 AppSecret 必須同時填寫；不填時不會連線 QQ。
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
# 選填。設定後只回應此 QQ user_openid 的私聊訊息。
QQ_ALLOWED_USER_OPENID=

# 對話API
# 支援 OpenAI-compatible Chat Completions API。
# 供應商可用：deepseek / openai / gemini / zhipu / openrouter / custom。
CHAT_API_PROVIDER=deepseek
# OpenRouter 推理供應商 slug；留空自動路由，指定後不跨供應商備援。
CHAT_API_OPENROUTER_PROVIDER=
# 正文、壓縮、大模型處理及所有故事共用目前供應商的這一把 Key。
CHAT_API_KEY=
# 只有 custom 使用此欄位；其他供應商固定使用以下官方網址。
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# 智譜 GLM: https://open.bigmodel.cn/api/paas/v4
# OpenRouter: https://openrouter.ai/api/v1
CHAT_API_BASE_URL=
# API輸出模型。DeepSeek 預設使用 deepseek-v4-pro。
CHAT_API_MODEL=deepseek-v4-pro
# 思考強度依模型支援範圍設定；DeepSeek 留空使用 high，其他供應商留空使用 API 預設。
# Gemini Argon 可選 low、medium、high；部分 Gemini 可選 minimal；僅支援關閉的模型接受 none。
CHAT_API_REASONING_EFFORT=
# 網頁環境設定會另外保存各供應商先前使用的 Key、模型與 Base URL，切換時自動帶回。
# 執行時只會使用目前 CHAT_API_PROVIDER 的通用與專屬 Key，不會跨供應商回退。
# API 請求逾時時間，單位是毫秒。預設：600000（10 分鐘）。
CHAT_API_REQUEST_TIMEOUT_MS=600000
# 暫時性連線／HTTP 失敗的額外重試次數（0–20，預設 3）；0 不重試，20 最多共 21 次請求。
# 等待逐次延後，整組重試仍受上方逾時限制；已開始輸出的串流不重跑。
CHAT_API_RETRY_COUNT=3
# 選填。覆蓋輸出 token 上限；主聊天／壓縮呼叫預設 32000，仍會受模型上限限制。
# CHAT_API_MAX_TOKENS=32000
# 大多數 OpenAI-compatible API 使用 max_tokens；部分 OpenAI 新模型可改用 max_completion_tokens。
CHAT_API_MAX_TOKENS_PARAM=max_tokens
# 選填。範圍 0 至 2，支援 0.1 等小數；一般對話留空時使用 0.5。DeepSeek 思考模式開啟時不生效。
# CHAT_API_TEMPERATURE=0.5
# 網頁與 Discord 圖片附件限制。預設每次 4 張、每張 5 MB。
CHAT_IMAGE_ATTACHMENT_MAX_COUNT=4
CHAT_IMAGE_ATTACHMENT_MAX_BYTES=5242880

# 圖片輸入方式：main 由主要模型直接讀圖；specialist 先由獨立圖片模型轉成文字描述。
CHAT_IMAGE_INPUT_MODE=main
# specialist 模式使用獨立 OpenAI-compatible Chat Completions API。
CHAT_IMAGE_API_PROVIDER=
CHAT_IMAGE_API_OPENROUTER_PROVIDER=
# 只有 custom 使用此欄位；其他供應商固定使用官方網址。
CHAT_IMAGE_API_BASE_URL=
CHAT_IMAGE_API_MODEL=
# 圖片模型獨立思考強度，選項依模型支援範圍；Gemini Argon 可設 low、medium、high。
CHAT_IMAGE_API_REASONING_EFFORT=
# 選填，範圍 0 至 2；思考開啟時不會送出。
CHAT_IMAGE_API_TEMPERATURE=
CHAT_IMAGE_API_KEY=

# 自訂每百萬 token 單價；可在網頁「API 計價」編輯，實際 API 費用仍優先。
# JSON 必須用單引號包住；每組綁定 provider、model、endpoint、currency 及三項 PerMillion 單價。
API_PRICING_OVERRIDES='[]'

# API Proxy：對話、專用圖片模型、NovelAI 與模型清單共用；留空直接連線。
# 支援 http:// 或 https://，不填協定時使用 http://。
API_PROXY_URL=
API_PROXY_USERNAME=
API_PROXY_PASSWORD=

# 回覆行為
# 最終回覆的最少可見字數；太短時會觸發提示或補救流程。
AI_MIN_REPLY_CHARS=600
